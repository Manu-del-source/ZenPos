# ---------------------------------------------------------------------------
# Kipchi POS - API (Django) environment template
#
# Copy this file to `apps/api/.env` and fill in local values:
#     cp .env.example apps/api/.env
# `.env` is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Django core ----------------------------------------------------------
# Set DJANGO_DEBUG=false in production. The API refuses to boot in non-debug
# mode without DJANGO_SECRET_KEY.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL / Neon ---------------------------------------------------
# Render should use the single pooled/direct connection string from Neon.
# Example: postgresql://user:password@ep-...neon.tech/dbname?sslmode=require
DATABASE_URL=
POSTGRES_SSL_REQUIRE=true

POSTGRES_DB=kipchi_pos
POSTGRES_USER=kipchi
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Auth tokens ----------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- CORS / CSRF ----------------------------------------------------------
# Comma-separated allowlists. There is no "allow all" mode.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO

# --- M-Pesa (Safaricom Daraja) -------------------------------------------
# Obtain from https://developer.safaricom.co.ke (sandbox) or the production
# portal. These are never hard-coded in source and never exposed to the browser.
# MPESA_ENV selects the API host: sandbox or production.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# The public base URL Safaricom should call back, e.g.
# https://api.example.com/callbacks. The app appends the secret segment below
# before registering it with Safaricom.
MPESA_CALLBACK_URL=
# Secret path segment of the callback URL (unguessable, rotatable). Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The callback endpoint rejects everything while this is unset.
MPESA_CALLBACK_SECRET=
