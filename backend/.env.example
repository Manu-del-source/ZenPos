# FastAPI/SQLite security settings for backend/api.py.
# Keep real values in an untracked .env or deployment environment settings.
JWT_SECRET_KEY=
# Legacy Express JWT key; keep it separate from the FastAPI signing key.
JWT_SECRET=
JWT_ACCESS_MINUTES=30
PORT=5000
CORS_ORIGINS=http://localhost:5173,https://kipchi-pos.vercel.app

# Optional first-run administrator bootstrap. Use a unique password of at least
# 12 characters. The account is created only when this username does not exist.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_RESET=false

# One-time reset for an existing legacy account (run python -m
# backend.reset_password, then remove both values from the environment).
RESET_USERNAME=
RESET_PASSWORD=

# Optional, seed-tool-only value for the preserved Express/Prisma seed scripts.
# Do not reuse a cashier password or enable production test accounts.
BOOTSTRAP_CASHIER_PASSWORD=

# M-Pesa is disabled until all credentials and a callback URL are configured.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
