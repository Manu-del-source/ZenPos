{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "realtime",
          "format": "url",
          "env": "REALTIME_URL"
        }
      ]
    },
    "realtime": {
      "root": ".",
      "entrypoint": "realtime.js",
      "framework": "express"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/realtime/(.*)",
      "destination": {
        "service": "realtime"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
